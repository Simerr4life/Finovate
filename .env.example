# Copy this file to .env and fill in values as needed.
# The app runs fully in local/demo mode with none of these set.

# --- Core Django settings ---
FINOVATE_SECRET_KEY=
FINOVATE_DEBUG=true
FINOVATE_ALLOWED_HOSTS=localhost,127.0.0.1
FINOVATE_DB_PATH=
FINOVATE_LOG_LEVEL=INFO

# Demo mode shows "Demo Mode" banners, enables the seed-data management
# command's safety rails, and is the default for local development.
FINOVATE_DEMO_MODE=true

# --- Future integrations (placeholders only, not read by any code path
# that runs today; see docs/integration-readiness.md) ---

# Identity provider (Auth0). Set all three to enable the "Log in with
# Auth0" button; leave empty to keep using local demo login/signup.
# Create a "Regular Web Application" in your Auth0 tenant and set its
# Allowed Callback URL to <your-app-url>/accounts/auth0/callback/
# (e.g. http://127.0.0.1:8765/accounts/auth0/callback/ for local dev)
# and Allowed Logout URL to <your-app-url>/.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Hosted Postgres (e.g. Supabase). Set either one to switch off SQLite —
# use Supabase's connection-pooling URI (Project Settings -> Database).
# Leave both empty to keep using local SQLite.
DATABASE_URL=
SUPABASE_DB_URL=

# Bank transaction/balance provider — future replacement for manual entry.
BANK_PROVIDER_API_KEY=

# Brokerage/ETF provider — future replacement for simulated investing.
BROKERAGE_PROVIDER_API_KEY=

# Messaging provider (e.g. a Photon-based product) — future companion
# channel. Exact provider/capabilities are unconfirmed; do not guess.
MESSAGING_PROVIDER_API_KEY=

# Shared secret the /assistant/photon-webhook/ endpoint checks on the
# X-Photon-Webhook-Secret header. Leave empty for local demo use. The
# actual header name is unverified against the real Photon service —
# see docs/messaging-assistant.md.
PHOTON_WEBHOOK_SECRET=
