# Copy this file to .env and fill in values as needed.
# The app runs fully in local/demo mode with none of these set.

# --- Core Django settings ---
FINOVATE_SECRET_KEY=
FINOVATE_DEBUG=true
FINOVATE_ALLOWED_HOSTS=localhost,127.0.0.1
FINOVATE_DB_PATH=
FINOVATE_LOG_LEVEL=INFO

# Demo mode shows "Demo Mode" banners, enables the seed-data management
# command's safety rails, and is the default for local development.
FINOVATE_DEMO_MODE=true

# --- Future integrations (placeholders only, not read by any code path
# that runs today; see docs/integration-readiness.md) ---

# Identity provider (e.g. Auth0) — future replacement for demo auth.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Bank transaction/balance provider — future replacement for manual entry.
BANK_PROVIDER_API_KEY=

# Brokerage/ETF provider — future replacement for simulated investing.
BROKERAGE_PROVIDER_API_KEY=

# Messaging provider (e.g. a Photon-based product) — future companion
# channel. Exact provider/capabilities are unconfirmed; do not guess.
MESSAGING_PROVIDER_API_KEY=
