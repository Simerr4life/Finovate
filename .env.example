# Copy this file to .env and fill in values as needed.
# The app runs fully in local/demo mode with none of these set.

# --- Core Django settings ---
FINOVATE_SECRET_KEY=
FINOVATE_DEBUG=true
FINOVATE_ALLOWED_HOSTS=localhost,127.0.0.1
FINOVATE_DB_PATH=
FINOVATE_LOG_LEVEL=INFO

# Optional. The product UI does not show a demo-mode banner.
FINOVATE_DEMO_MODE=false

# Local demo user password for `python manage.py seed_demo`.
# Required when DEBUG is false. Never commit a real value.
DEMO_ACCOUNT_PASSWORD=

# --- Integrations (placeholders only; never put real secrets here) ---

# Identity provider (Auth0). Website registration and login stay
# unavailable until all four AUTH0_* values below are set. Finovate does
# not store passwords. Leave the management values empty unless a
# separate machine-to-machine application is authorized to resend
# verification email (scope update:users). Never put real secrets here.
#
# AUTH0_DOMAIN: tenant host, such as your-tenant.us.auth0.com
# AUTH0_CLIENT_ID: Regular Web Application client id
# AUTH0_CLIENT_SECRET: that application's client secret (server only)
# AUTH0_SECRET: long random string used to encrypt the Auth0 session cookie
# AUTH0_AUDIENCE: Finovate API identifier, https://finovate.biz/api
#   Required before protected API calls accept access tokens.
#   Do not set this to the application client id.
# AUTH0_MGMT_CLIENT_ID / AUTH0_MGMT_CLIENT_SECRET: optional server-only
#   machine-to-machine application for verification-email resend.
# APP_BASE_URL: origin Auth0 redirects back to. Callback is
#   <APP_BASE_URL>/callback and logout return is <APP_BASE_URL>/.
#   Local: http://127.0.0.1:8000 or http://localhost:5000
#   Production: https://finovate.biz
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_AUDIENCE=
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
APP_BASE_URL=http://127.0.0.1:8000

# Hosted Postgres (e.g. Supabase). Set either one to switch off SQLite —
# use Supabase's connection-pooling URI (Project Settings -> Database).
# Leave both empty to keep using local SQLite.
DATABASE_URL=
SUPABASE_DB_URL=

# Bank transaction/balance provider — future replacement for manual entry.
BANK_PROVIDER_API_KEY=

# Brokerage/ETF provider — future replacement for simulated investing.
BROKERAGE_PROVIDER_API_KEY=

# Photon Spectrum (iMessage). Stable docs: https://photon.codes/docs/webhooks
# The Django app verifies inbound webhooks. It does not send iMessage;
# outbound delivery uses Photon's Node adapter. See docs/messaging-assistant.md.
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=
# Older name, used only if IMESSAGE_WEBHOOK_SECRET is empty.
PHOTON_WEBHOOK_SECRET=
