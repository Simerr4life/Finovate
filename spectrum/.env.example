# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Django app the adapter asks for replies.
FINOVATE_URL=http://127.0.0.1:8000

# Must match Django ASSISTANT_BRIDGE_SECRET (or IMESSAGE_PROJECT_SECRET).
# Defaults to PROJECT_SECRET when empty.
ASSISTANT_BRIDGE_SECRET=

# Comma-separated: imessage | terminal | imessage,terminal
SPECTRUM_PROVIDERS=imessage
